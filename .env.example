PORT=8080

# Optional AI provider settings.
# PID Advisor can still use local engineering rules when AI_PROVIDER=local.
# API keys are read only by the Python backend. Never put keys in frontend code.
AI_PROVIDER=openai
AI_MODEL_FAST=gpt-5.4-nano
AI_MODEL_DEFAULT=gpt-5.4-mini
AI_MODEL_FINAL=gpt-5.5
AI_REPORT_PROVIDER=openai
AI_REPORT_MODEL=gpt-5.4-mini
AI_PID_MODEL=gpt-5.4-mini
AI_FINAL_REVIEW_MODEL=gpt-5.5
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# Reserved for future provider switching.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_DEFAULT=deepseek-v4-pro
# Optional. Use this when Python cannot reach api.openai.com directly.
# Example: OPENAI_PROXY=http://127.0.0.1:7890
OPENAI_PROXY=
OPENAI_AUTO_PROXY=1
OPENAI_PROXY_PORTS=7890,7897,7899,10809,10808,1087,1080
OPENAI_TIMEOUT=120
AI_REPORT_MAX_INPUT_CHARS=18000

# Optional local UI account defaults.
GCS_ADMIN_USER=admin
GCS_ADMIN_PASSWORD=px6c-admin
GCS_OPERATOR_USER=operator
GCS_OPERATOR_PASSWORD=px6c-operator
